//@version=6
strategy("RSI + SMMA Strategy", shorttitle="RSI+SMMA", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, slippage=2, pyramiding=0)

// ============================================================================
// STRATEGY LOGIC:
// 1. Price SMMA (plotted on chart) determines trade bias (long/short)
// 2. RSI SMMA (calculated, not plotted) provides entry signal
//
// LONG: Price > Price SMMA AND RSI > RSI SMMA
// SHORT: Price < Price SMMA AND RSI < RSI SMMA
//
// NOTE: RSI and RSI SMMA are calculated internally for signal logic only.
//       They are NOT plotted - only Price SMMA is visible on the chart.
// ============================================================================

// ============================================================================
// INPUTS
// ============================================================================

// Price SMMA Settings
priceSMMALength = input.int(20, "Price SMMA Length", minval=1, maxval=500, tooltip="SMMA period for price (determines trade bias)", group="Price SMMA")

// RSI Settings
rsiLength = input.int(14, "RSI Length", minval=1, maxval=200, tooltip="RSI calculation period", group="RSI Settings")
rsiSMMALength = input.int(10, "RSI SMMA Length", minval=1, maxval=200, tooltip="SMMA period applied to RSI (entry signal)", group="RSI Settings")

// Risk Management Settings
useStopLoss = input.bool(true, "Use Stop Loss", tooltip="Enable stop loss", group="Risk Management")
stopLossType = input.string("SMMA", "Stop Loss Type", options=["SMMA", "Percentage", "ATR"], tooltip="Stop loss calculation method", group="Risk Management")
stopLossPercent = input.float(2.0, "Stop Loss %", minval=0.1, maxval=10.0, tooltip="Stop loss percentage (if using Percentage type)", group="Risk Management")
atrMultiplier = input.float(2.0, "ATR Multiplier", minval=0.5, maxval=5.0, tooltip="ATR multiplier for stop loss (if using ATR type)", group="Risk Management")
atrLength = input.int(14, "ATR Length", minval=1, maxval=100, tooltip="ATR calculation period", group="Risk Management")

useTakeProfit = input.bool(true, "Use Take Profit", tooltip="Enable take profit targets", group="Risk Management")
takeProfitType = input.string("Risk Ratio", "Take Profit Type", options=["Risk Ratio", "Percentage"], tooltip="Take profit calculation method", group="Risk Management")
riskRewardRatio = input.float(2.0, "Risk/Reward Ratio", minval=0.5, maxval=10.0, tooltip="Take profit as multiple of stop loss distance", group="Risk Management")
takeProfitPercent = input.float(4.0, "Take Profit %", minval=0.5, maxval=20.0, tooltip="Take profit percentage (if using Percentage type)", group="Risk Management")

// Trading Controls
enableLongTrades = input.bool(true, "Enable Long Trades", tooltip="Allow long positions", group="Trading Controls")
enableShortTrades = input.bool(true, "Enable Short Trades", tooltip="Allow short positions", group="Trading Controls")

// Display Settings
showPriceSMMA = input.bool(true, "Show Price SMMA", tooltip="Display Price SMMA on chart", group="Display Settings")
showEntryExitMarkers = input.bool(true, "Show Entry/Exit Markers", tooltip="Display entry and exit points", group="Display Settings")
showInfoTable = input.bool(true, "Show Info Table", tooltip="Display strategy information table", group="Display Settings")

// ============================================================================
// SMMA CALCULATION FUNCTION
// ============================================================================

calcSMMA(float src, int length) =>
    var float smma = na
    if na(smma)
        smma := ta.sma(src, length)
    else
        smma := (smma * (length - 1) + src) / length
    smma

// ============================================================================
// CALCULATIONS
// ============================================================================

// Calculate Price SMMA (determines trade bias)
priceSMMA = calcSMMA(close, priceSMMALength)

// Calculate RSI
rsiValue = ta.rsi(close, rsiLength)

// Calculate RSI SMMA (entry signal)
rsiSMMA = calcSMMA(rsiValue, rsiSMMALength)

// Calculate ATR for risk management
atrValue = ta.atr(atrLength)

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

// LONG: Price above Price SMMA AND RSI above RSI SMMA
priceBullish = close > priceSMMA
rsiSignalLong = rsiValue > rsiSMMA
longCondition = enableLongTrades and priceBullish and rsiSignalLong and not (priceBullish[1] and rsiSignalLong[1])

// SHORT: Price below Price SMMA AND RSI below RSI SMMA
priceBearish = close < priceSMMA
rsiSignalShort = rsiValue < rsiSMMA
shortCondition = enableShortTrades and priceBearish and rsiSignalShort and not (priceBearish[1] and rsiSignalShort[1])

// EXIT CONDITIONS
// Exit when alignment breaks
longExitCondition = close < priceSMMA or rsiValue < rsiSMMA
shortExitCondition = close > priceSMMA or rsiValue > rsiSMMA

// ============================================================================
// CALCULATE STOP LOSS AND TAKE PROFIT LEVELS
// ============================================================================

var float longStopLoss = na
var float longTakeProfit = na
var float shortStopLoss = na
var float shortTakeProfit = na

if longCondition
    if useStopLoss
        if stopLossType == "SMMA"
            longStopLoss := priceSMMA
        else if stopLossType == "Percentage"
            longStopLoss := close * (1 - stopLossPercent / 100)
        else if stopLossType == "ATR"
            longStopLoss := close - (atrValue * atrMultiplier)

    if useTakeProfit
        stopDistance = useStopLoss ? (close - longStopLoss) : (close * stopLossPercent / 100)
        if takeProfitType == "Risk Ratio"
            longTakeProfit := close + (stopDistance * riskRewardRatio)
        else if takeProfitType == "Percentage"
            longTakeProfit := close * (1 + takeProfitPercent / 100)

if shortCondition
    if useStopLoss
        if stopLossType == "SMMA"
            shortStopLoss := priceSMMA
        else if stopLossType == "Percentage"
            shortStopLoss := close * (1 + stopLossPercent / 100)
        else if stopLossType == "ATR"
            shortStopLoss := close + (atrValue * atrMultiplier)

    if useTakeProfit
        stopDistance = useStopLoss ? (shortStopLoss - close) : (close * stopLossPercent / 100)
        if takeProfitType == "Risk Ratio"
            shortTakeProfit := close - (stopDistance * riskRewardRatio)
        else if takeProfitType == "Percentage"
            shortTakeProfit := close * (1 - takeProfitPercent / 100)

// ============================================================================
// STRATEGY EXECUTION
// ============================================================================

// Enter Long Position
if longCondition
    if useStopLoss and useTakeProfit
        strategy.entry("Long", strategy.long, comment="Long Entry")
        strategy.exit("Long Exit", "Long", stop=longStopLoss, limit=longTakeProfit, comment="SL/TP")
    else if useStopLoss
        strategy.entry("Long", strategy.long, comment="Long Entry")
        strategy.exit("Long Exit", "Long", stop=longStopLoss, comment="SL")
    else if useTakeProfit
        strategy.entry("Long", strategy.long, comment="Long Entry")
        strategy.exit("Long Exit", "Long", limit=longTakeProfit, comment="TP")
    else
        strategy.entry("Long", strategy.long, comment="Long Entry")

// Enter Short Position
if shortCondition
    if useStopLoss and useTakeProfit
        strategy.entry("Short", strategy.short, comment="Short Entry")
        strategy.exit("Short Exit", "Short", stop=shortStopLoss, limit=shortTakeProfit, comment="SL/TP")
    else if useStopLoss
        strategy.entry("Short", strategy.short, comment="Short Entry")
        strategy.exit("Short Exit", "Short", stop=shortStopLoss, comment="SL")
    else if useTakeProfit
        strategy.entry("Short", strategy.short, comment="Short Entry")
        strategy.exit("Short Exit", "Short", limit=shortTakeProfit, comment="TP")
    else
        strategy.entry("Short", strategy.short, comment="Short Entry")

// Exit on signal reversal
if longExitCondition
    strategy.close("Long", comment="Signal Exit")

if shortExitCondition
    strategy.close("Short", comment="Signal Exit")

// ============================================================================
// PLOTTING - PRICE CHART
// ============================================================================

// Plot Price SMMA
plot(showPriceSMMA ? priceSMMA : na, "Price SMMA", color=color.new(color.orange, 0), linewidth=2)

// Plot stop loss and take profit levels for current position
plot(strategy.position_size > 0 and useStopLoss ? longStopLoss : na, "Long Stop Loss", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size > 0 and useTakeProfit ? longTakeProfit : na, "Long Take Profit", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 and useStopLoss ? shortStopLoss : na, "Short Stop Loss", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 and useTakeProfit ? shortTakeProfit : na, "Short Take Profit", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=1)

// Entry/Exit markers
plotshape(showEntryExitMarkers and longCondition, "Long Entry", shape.triangleup, location.belowbar, color=color.new(color.green, 0), size=size.small)
plotshape(showEntryExitMarkers and shortCondition, "Short Entry", shape.triangledown, location.abovebar, color=color.new(color.red, 0), size=size.small)

// Background color based on price vs SMMA
bgcolor(priceBullish ? color.new(color.green, 95) : color.new(color.red, 95), title="Price Bias Background")

// ============================================================================
// INFO TABLE
// ============================================================================

if showInfoTable
    var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)
    if barstate.islast
        table.cell(infoTable, 0, 0, "Price vs SMMA", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(infoTable, 1, 0, priceBullish ? "ABOVE" : "BELOW", text_color=priceBullish ? color.lime : color.red, text_size=size.small, bgcolor=color.new(color.gray, 80))

        table.cell(infoTable, 0, 1, "RSI vs SMMA", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        rsiAboveSmma = rsiValue > rsiSMMA
        table.cell(infoTable, 1, 1, rsiAboveSmma ? "ABOVE" : "BELOW", text_color=rsiAboveSmma ? color.lime : color.red, text_size=size.small, bgcolor=color.new(color.gray, 80))

        table.cell(infoTable, 0, 2, "RSI Value", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(infoTable, 1, 2, str.tostring(math.round(rsiValue, 2)), text_color=rsiValue >= 70 ? color.lime : (rsiValue <= 30 ? color.red : color.white), text_size=size.small, bgcolor=color.new(color.gray, 80))

        table.cell(infoTable, 0, 3, "Position", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        positionText = strategy.position_size > 0 ? "LONG" : (strategy.position_size < 0 ? "SHORT" : "NONE")
        positionColor = strategy.position_size > 0 ? color.lime : (strategy.position_size < 0 ? color.red : color.gray)
        table.cell(infoTable, 1, 3, positionText, text_color=positionColor, text_size=size.small, bgcolor=color.new(color.gray, 80))

        table.cell(infoTable, 0, 4, "P&L", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        plColor = strategy.netprofit >= 0 ? color.lime : color.red
        table.cell(infoTable, 1, 4, str.tostring(math.round(strategy.netprofit, 2)), text_color=plColor, text_size=size.small, bgcolor=color.new(color.gray, 80))

        table.cell(infoTable, 0, 5, "Win Rate", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        winRate = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100 : 0
        winRateColor = winRate >= 50 ? color.lime : (winRate >= 40 ? color.yellow : color.red)
        table.cell(infoTable, 1, 5, str.tostring(math.round(winRate, 1)) + "%", text_color=winRateColor, text_size=size.small, bgcolor=color.new(color.gray, 80))
