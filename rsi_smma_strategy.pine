//@version=6
strategy("RSI + SMMA Strategy", shorttitle="RSI+SMMA", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, slippage=2, pyramiding=0)

// ============================================================================
// CORE FUNCTIONS
// ============================================================================

calcSmma(float src, int length) =>
    var float smma = na
    if na(smma)
        smma := ta.sma(src, length)
    else
        smma := (smma * (length - 1) + src) / length
    smma

getRsiSmmaStrength(int rsiLength, int fastSmmaLength, int slowSmmaLength) =>
    rsiValue = ta.rsi(close, rsiLength)
    fastSmma = calcSmma(close, fastSmmaLength)
    slowSmma = calcSmma(close, slowSmmaLength)
    priceAboveFastSmma = close > fastSmma
    priceAboveSlowSmma = close > slowSmma
    fastAboveSlow = fastSmma > slowSmma
    rsiOverbought = rsiValue >= 70.0
    rsiOversold = rsiValue <= 30.0
    rsiBullish = rsiValue > 50.0
    rsiBearish = rsiValue < 50.0
    strength = 0
    if rsiOverbought and priceAboveFastSmma and priceAboveSlowSmma and fastAboveSlow
        strength := 3
    else if rsiBullish and priceAboveFastSmma and fastAboveSlow
        strength := 2
    else if rsiBullish and priceAboveFastSmma
        strength := 1
    else if rsiOversold and not priceAboveFastSmma and not priceAboveSlowSmma and not fastAboveSlow
        strength := -3
    else if rsiBearish and not priceAboveFastSmma and not fastAboveSlow
        strength := -2
    else if rsiBearish and not priceAboveFastSmma
        strength := -1
    strength

calculateRsiSmmaTrendScale(int rsiLength, int fastSmmaLength, int slowSmmaLength, int adxLength, float adxStrongThreshold, float adxWeakThreshold) =>
    rsiSmmaStrength = getRsiSmmaStrength(rsiLength, fastSmmaLength, slowSmmaLength)
    [diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)
    scale = 5
    if rsiSmmaStrength == 3
        scale := adx >= adxStrongThreshold ? 9 : (adx >= adxWeakThreshold ? 8 : 7)
    else if rsiSmmaStrength == 2
        scale := adx >= adxStrongThreshold ? 8 : 7
    else if rsiSmmaStrength == 1
        scale := adx >= adxStrongThreshold ? 7 : 6
    else if rsiSmmaStrength == 0
        scale := 5
    else if rsiSmmaStrength == -1
        scale := adx >= adxStrongThreshold ? 3 : 4
    else if rsiSmmaStrength == -2
        scale := adx >= adxStrongThreshold ? 2 : 3
    else if rsiSmmaStrength == -3
        scale := adx >= adxStrongThreshold ? 1 : (adx >= adxWeakThreshold ? 2 : 3)
    scale

// ============================================================================
// INPUTS
// ============================================================================

// Strategy Settings
entrySignalLevel = input.int(7, "Entry Signal Level (Long)", minval=6, maxval=9, tooltip="Trend scale level required to enter long (7=Long, 8=Strong Long, 9=Very Strong Long)", group="Strategy Settings")
exitSignalLevel = input.int(5, "Exit Signal Level", minval=1, maxval=5, tooltip="Trend scale level that triggers exit (5=Neutral, 4=Weak Short)", group="Strategy Settings")
shortEntryLevel = input.int(3, "Entry Signal Level (Short)", minval=1, maxval=4, tooltip="Trend scale level required to enter short (3=Short, 2=Strong Short, 1=Very Strong Short)", group="Strategy Settings")
enableLongTrades = input.bool(true, "Enable Long Trades", tooltip="Allow long positions", group="Strategy Settings")
enableShortTrades = input.bool(true, "Enable Short Trades", tooltip="Allow short positions", group="Strategy Settings")

// RSI Settings
rsiLength = input.int(14, "RSI Length", minval=1, maxval=200, tooltip="Standard RSI period (default 14)", group="RSI Settings")

// SMMA Settings
fastSmmaLength = input.int(10, "Fast SMMA Length", minval=1, maxval=200, tooltip="Fast Smoothed Moving Average period", group="SMMA Settings")
slowSmmaLength = input.int(20, "Slow SMMA Length", minval=1, maxval=500, tooltip="Slow Smoothed Moving Average period", group="SMMA Settings")

// ADX Strength Settings
adxLength = input.int(14, "ADX Length", minval=1, maxval=100, tooltip="ADX calculation period", group="Strength Settings")
adxStrongThreshold = input.float(30.0, "Strong Trend ADX", minval=0, maxval=100, tooltip="ADX threshold for strong trend", group="Strength Settings")
adxWeakThreshold = input.float(20.0, "Weak Trend ADX", minval=0, maxval=100, tooltip="ADX threshold for weak trend", group="Strength Settings")

// Risk Management Settings
useStopLoss = input.bool(true, "Use Stop Loss", tooltip="Enable stop loss based on SMMA", group="Risk Management")
stopLossType = input.string("SMMA", "Stop Loss Type", options=["SMMA", "Percentage", "ATR"], tooltip="Stop loss calculation method", group="Risk Management")
stopLossPercent = input.float(2.0, "Stop Loss %", minval=0.1, maxval=10.0, tooltip="Stop loss percentage (if using Percentage type)", group="Risk Management")
atrMultiplier = input.float(2.0, "ATR Multiplier", minval=0.5, maxval=5.0, tooltip="ATR multiplier for stop loss (if using ATR type)", group="Risk Management")
atrLength = input.int(14, "ATR Length", minval=1, maxval=100, tooltip="ATR calculation period", group="Risk Management")

useTakeProfit = input.bool(true, "Use Take Profit", tooltip="Enable take profit targets", group="Risk Management")
takeProfitType = input.string("Risk Ratio", "Take Profit Type", options=["Risk Ratio", "Percentage", "Fixed"], tooltip="Take profit calculation method", group="Risk Management")
riskRewardRatio = input.float(2.0, "Risk/Reward Ratio", minval=0.5, maxval=10.0, tooltip="Take profit as multiple of stop loss distance", group="Risk Management")
takeProfitPercent = input.float(4.0, "Take Profit %", minval=0.5, maxval=20.0, tooltip="Take profit percentage (if using Percentage type)", group="Risk Management")

// Display Settings
showSmmaLines = input.bool(true, "Show SMMA Lines on Chart", tooltip="Display Fast and Slow SMMA lines", group="Display Settings")
showEntryExitMarkers = input.bool(true, "Show Entry/Exit Markers", tooltip="Display entry and exit points", group="Display Settings")
showInfoTable = input.bool(true, "Show Info Table", tooltip="Display strategy information table", group="Display Settings")

// ============================================================================
// CALCULATIONS
// ============================================================================

// Calculate trend scale
trendScale = calculateRsiSmmaTrendScale(rsiLength, fastSmmaLength, slowSmmaLength, adxLength, adxStrongThreshold, adxWeakThreshold)

// Calculate SMMA values for plotting and stop loss
fastSmma = calcSmma(close, fastSmmaLength)
slowSmma = calcSmma(close, slowSmmaLength)

// Calculate RSI and ADX for display
rsiValue = ta.rsi(close, rsiLength)
[diPlus, diMinus, adxValue] = ta.dmi(adxLength, adxLength)

// Calculate ATR for risk management
atrValue = ta.atr(atrLength)

// ============================================================================
// ENTRY/EXIT CONDITIONS
// ============================================================================

// Long entry: Trend scale reaches entry level
longCondition = enableLongTrades and trendScale >= entrySignalLevel and trendScale[1] < entrySignalLevel

// Short entry: Trend scale reaches short entry level
shortCondition = enableShortTrades and trendScale <= shortEntryLevel and trendScale[1] > shortEntryLevel

// Exit conditions
longExitCondition = trendScale <= exitSignalLevel
shortExitCondition = trendScale >= (10 - exitSignalLevel)

// ============================================================================
// CALCULATE STOP LOSS AND TAKE PROFIT LEVELS
// ============================================================================

var float longStopLoss = na
var float longTakeProfit = na
var float shortStopLoss = na
var float shortTakeProfit = na

if longCondition
    if useStopLoss
        if stopLossType == "SMMA"
            longStopLoss := slowSmma
        else if stopLossType == "Percentage"
            longStopLoss := close * (1 - stopLossPercent / 100)
        else if stopLossType == "ATR"
            longStopLoss := close - (atrValue * atrMultiplier)

    if useTakeProfit
        stopDistance = useStopLoss ? (close - longStopLoss) : (close * stopLossPercent / 100)
        if takeProfitType == "Risk Ratio"
            longTakeProfit := close + (stopDistance * riskRewardRatio)
        else if takeProfitType == "Percentage"
            longTakeProfit := close * (1 + takeProfitPercent / 100)
        else if takeProfitType == "Fixed"
            longTakeProfit := close + (close * takeProfitPercent / 100)

if shortCondition
    if useStopLoss
        if stopLossType == "SMMA"
            shortStopLoss := slowSmma
        else if stopLossType == "Percentage"
            shortStopLoss := close * (1 + stopLossPercent / 100)
        else if stopLossType == "ATR"
            shortStopLoss := close + (atrValue * atrMultiplier)

    if useTakeProfit
        stopDistance = useStopLoss ? (shortStopLoss - close) : (close * stopLossPercent / 100)
        if takeProfitType == "Risk Ratio"
            shortTakeProfit := close - (stopDistance * riskRewardRatio)
        else if takeProfitType == "Percentage"
            shortTakeProfit := close * (1 - takeProfitPercent / 100)
        else if takeProfitType == "Fixed"
            shortTakeProfit := close - (close * takeProfitPercent / 100)

// ============================================================================
// STRATEGY EXECUTION
// ============================================================================

// Enter Long Position
if longCondition
    if useStopLoss and useTakeProfit
        strategy.entry("Long", strategy.long, comment="Long Entry")
        strategy.exit("Long Exit", "Long", stop=longStopLoss, limit=longTakeProfit, comment="SL/TP")
    else if useStopLoss
        strategy.entry("Long", strategy.long, comment="Long Entry")
        strategy.exit("Long Exit", "Long", stop=longStopLoss, comment="SL")
    else if useTakeProfit
        strategy.entry("Long", strategy.long, comment="Long Entry")
        strategy.exit("Long Exit", "Long", limit=longTakeProfit, comment="TP")
    else
        strategy.entry("Long", strategy.long, comment="Long Entry")

// Enter Short Position
if shortCondition
    if useStopLoss and useTakeProfit
        strategy.entry("Short", strategy.short, comment="Short Entry")
        strategy.exit("Short Exit", "Short", stop=shortStopLoss, limit=shortTakeProfit, comment="SL/TP")
    else if useStopLoss
        strategy.entry("Short", strategy.short, comment="Short Entry")
        strategy.exit("Short Exit", "Short", stop=shortStopLoss, comment="SL")
    else if useTakeProfit
        strategy.entry("Short", strategy.short, comment="Short Entry")
        strategy.exit("Short Exit", "Short", limit=shortTakeProfit, comment="TP")
    else
        strategy.entry("Short", strategy.short, comment="Short Entry")

// Exit on signal reversal
if longExitCondition
    strategy.close("Long", comment="Signal Exit")

if shortExitCondition
    strategy.close("Short", comment="Signal Exit")

// ============================================================================
// PLOTTING
// ============================================================================

// Plot SMMA lines
plot(showSmmaLines ? fastSmma : na, "Fast SMMA", color=color.new(color.blue, 0), linewidth=2)
plot(showSmmaLines ? slowSmma : na, "Slow SMMA", color=color.new(color.orange, 0), linewidth=2)

// Plot stop loss and take profit levels for current position
plot(strategy.position_size > 0 and useStopLoss ? longStopLoss : na, "Long Stop Loss", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size > 0 and useTakeProfit ? longTakeProfit : na, "Long Take Profit", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 and useStopLoss ? shortStopLoss : na, "Short Stop Loss", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 and useTakeProfit ? shortTakeProfit : na, "Short Take Profit", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=1)

// Entry/Exit markers
plotshape(showEntryExitMarkers and longCondition, "Long Entry", shape.triangleup, location.belowbar, color=color.new(color.green, 0), size=size.small)
plotshape(showEntryExitMarkers and shortCondition, "Short Entry", shape.triangledown, location.abovebar, color=color.new(color.red, 0), size=size.small)

// Background color based on trend scale
bgcolor(trendScale >= 8 ? color.new(color.green, 90) : trendScale >= 7 ? color.new(color.green, 95) : trendScale <= 2 ? color.new(color.red, 90) : trendScale <= 3 ? color.new(color.red, 95) : na, title="Trend Background")

// ============================================================================
// INFO TABLE
// ============================================================================

if showInfoTable
    var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)
    if barstate.islast
        table.cell(infoTable, 0, 0, "Trend Scale", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(infoTable, 1, 0, str.tostring(trendScale), text_color=trendScale >= 7 ? color.lime : (trendScale <= 3 ? color.red : color.yellow), text_size=size.small, bgcolor=color.new(color.gray, 80))
        table.cell(infoTable, 0, 1, "RSI", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(infoTable, 1, 1, str.tostring(math.round(rsiValue, 2)), text_color=rsiValue >= 70 ? color.lime : (rsiValue <= 30 ? color.red : color.white), text_size=size.small, bgcolor=color.new(color.gray, 80))
        table.cell(infoTable, 0, 2, "ADX", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        table.cell(infoTable, 1, 2, str.tostring(math.round(adxValue, 2)), text_color=adxValue >= adxStrongThreshold ? color.lime : (adxValue >= adxWeakThreshold ? color.yellow : color.red), text_size=size.small, bgcolor=color.new(color.gray, 80))
        table.cell(infoTable, 0, 3, "Position", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        positionText = strategy.position_size > 0 ? "LONG" : (strategy.position_size < 0 ? "SHORT" : "NONE")
        positionColor = strategy.position_size > 0 ? color.lime : (strategy.position_size < 0 ? color.red : color.gray)
        table.cell(infoTable, 1, 3, positionText, text_color=positionColor, text_size=size.small, bgcolor=color.new(color.gray, 80))
        table.cell(infoTable, 0, 4, "P&L", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        plColor = strategy.netprofit >= 0 ? color.lime : color.red
        table.cell(infoTable, 1, 4, str.tostring(math.round(strategy.netprofit, 2)), text_color=plColor, text_size=size.small, bgcolor=color.new(color.gray, 80))
        table.cell(infoTable, 0, 5, "Win Rate", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70))
        winRate = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100 : 0
        winRateColor = winRate >= 50 ? color.lime : (winRate >= 40 ? color.yellow : color.red)
        table.cell(infoTable, 1, 5, str.tostring(math.round(winRate, 1)) + "%", text_color=winRateColor, text_size=size.small, bgcolor=color.new(color.gray, 80))
