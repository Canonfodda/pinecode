//@version=6
indicator("6-State Trend Detector", overlay=false)

// ===== INPUT PARAMETERS =====
// Mode Selection
useAutoCalibration = input.bool(true, "Auto-Calibration Mode", tooltip="Automatically determine optimal settings based on chart characteristics", group="Mode")

// Manual Settings (used when Auto-Calibration is off)
manualHmaFast = input.int(9, "Fast HMA Length", minval=1, group="Manual Settings")
manualHmaSlow = input.int(21, "Slow HMA Length", minval=1, group="Manual Settings")
manualAdxLength = input.int(14, "ADX Length", minval=1, group="Manual Settings")
manualStrongThreshold = input.float(30, "Strong Trend ADX Threshold", minval=1, group="Manual Settings")
manualWeakThreshold = input.float(20, "Weak Trend ADX Threshold", minval=1, group="Manual Settings")

// Multi-Timeframe Settings
useHigherTimeframe = input.bool(true, "Use Higher Timeframe Confirmation", group="Multi-Timeframe")
htfMultiplier = input.int(3, "Higher Timeframe Multiplier", minval=2, maxval=10, tooltip="Multiplier for higher timeframe (3 = 3x current timeframe)", group="Multi-Timeframe")

// Auto-Calibration Lookback
calibrationBars = input.int(500, "Calibration Sample Size", minval=100, maxval=2000, tooltip="Number of bars to analyze for auto-calibration (will use available data if less than requested)", group="Mode")

// ===== DUAL CANDLE DATA =====
// Regular candles
regularClose = close
regularOpen = open
regularHigh = high
regularLow = low

// Heikin Ashi candles
haClose = request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close)
haOpen = request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, open)
haHigh = request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, high)
haLow = request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, low)

// ===== HULL MOVING AVERAGE FUNCTION =====
hma(src, length) =>
    wma1 = ta.wma(src, length / 2)
    wma2 = ta.wma(src, length)
    ta.wma(2 * wma1 - wma2, int(math.sqrt(length)))

// ===== AUTO-CALIBRATION LOGIC =====
// Analyze market characteristics to determine optimal settings
var float autoHmaFast = 9.0
var float autoHmaSlow = 21.0
var float autoStrongThreshold = 30.0
var float autoWeakThreshold = 20.0
var bool calibrationComplete = false

// Determine actual calibration bars based on available data
// bar_index starts at 0, so bar_index + 1 = total bars available
actualCalibrationBars = math.min(calibrationBars, bar_index)

// Run calibration once when enough data is available (minimum 100 bars)
// Calibration will use actualCalibrationBars or less depending on data availability
if useAutoCalibration and not calibrationComplete and bar_index >= 100
    // Use available data or requested calibration bars, whichever is smaller
    lookbackBars = actualCalibrationBars

    // Calculate average volatility using built-in functions (safe, no manual indexing)
    avgAtr = ta.sma(ta.atr(14), math.min(lookbackBars, 200))
    avgRange = ta.sma(high - low, math.min(lookbackBars, 200))
    volatilityRatio = avgAtr / avgRange

    // Calculate average price movement speed with safe indexing
    // We need close[i] and close[i+1], so max i is bar_index - 1
    // Number of price changes we can calculate = bar_index (from 0 to bar_index-1)
    priceChangeSum = 0.0
    maxSafeIndex = bar_index - 1
    numChanges = math.min(lookbackBars, maxSafeIndex + 1)
    if numChanges > 10
        for i = 0 to numChanges - 1
            if i <= maxSafeIndex
                priceChangeSum += math.abs(close[i] - close[i + 1])
        avgPriceChange = priceChangeSum / numChanges

    // Determine optimal HMA lengths based on volatility
    // Higher volatility = longer HMAs to filter noise
    // Lower volatility = shorter HMAs to catch moves faster
    if volatilityRatio > 1.5
        autoHmaFast := 12
        autoHmaSlow := 26
    else if volatilityRatio > 1.0
        autoHmaFast := 9
        autoHmaSlow := 21
    else
        autoHmaFast := 7
        autoHmaSlow := 16

    // Calculate ADX average using built-in SMA (safe approach)
    [diP, diM, currentAdx] = ta.dmi(14, 14)
    avgAdx = ta.sma(currentAdx, math.min(lookbackBars, 200))

    // Set thresholds based on average ADX
    // If market typically has low ADX, lower the thresholds
    if avgAdx < 20
        autoStrongThreshold := 25
        autoWeakThreshold := 15
    else if avgAdx < 30
        autoStrongThreshold := 30
        autoWeakThreshold := 20
    else
        autoStrongThreshold := 35
        autoWeakThreshold := 25

    // Mark calibration as complete
    calibrationComplete := true

// Use auto or manual settings
hmaFastLength = useAutoCalibration ? int(autoHmaFast) : manualHmaFast
hmaSlowLength = useAutoCalibration ? int(autoHmaSlow) : manualHmaSlow
adxLength = manualAdxLength
strongThreshold = useAutoCalibration ? autoStrongThreshold : manualStrongThreshold
weakThreshold = useAutoCalibration ? autoWeakThreshold : manualWeakThreshold

// ===== INDICATOR CALCULATIONS =====
// HMA Calculations on BOTH regular and Heikin Ashi candles
// Regular candles HMAs
regularHmaFast = hma(regularClose, hmaFastLength)
regularHmaSlow = hma(regularClose, hmaSlowLength)

// Heikin Ashi candles HMAs
haHmaFast = hma(haClose, hmaFastLength)
haHmaSlow = hma(haClose, hmaSlowLength)

// ADX for trend strength (use regular candles for ADX)
[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)

// Trend direction from both candle types
regularTrendUp = regularHmaFast > regularHmaSlow
regularTrendDown = regularHmaFast < regularHmaSlow

haTrendUp = haHmaFast > haHmaSlow
haTrendDown = haHmaFast < haHmaSlow

// Combined trend requires agreement from BOTH candle types
trendUp = regularTrendUp and haTrendUp
trendDown = regularTrendDown and haTrendDown

// Trend strength classification
strongTrend = adx >= strongThreshold
weakTrend = adx >= weakThreshold and adx < strongThreshold
noTrend = adx < weakThreshold

// ===== HIGHER TIMEFRAME CONFIRMATION =====
htfTimeframe = timeframe.period == "1" ? str.tostring(htfMultiplier) :
               timeframe.period == "5" ? str.tostring(5 * htfMultiplier) :
               timeframe.period == "15" ? str.tostring(15 * htfMultiplier) :
               timeframe.period == "60" ? str.tostring(60 * htfMultiplier) :
               timeframe.period == "240" ? str.tostring(240 * htfMultiplier) :
               timeframe.period == "D" ? "W" : "M"

htfHmaFast = useHigherTimeframe ? request.security(syminfo.tickerid, htfTimeframe, hma(close, hmaFastLength)) : regularHmaFast
htfHmaSlow = useHigherTimeframe ? request.security(syminfo.tickerid, htfTimeframe, hma(close, hmaSlowLength)) : regularHmaSlow
htfTrendUp = htfHmaFast > htfHmaSlow
htfTrendDown = htfHmaFast < htfHmaSlow

// Combine current timeframe and higher timeframe
confirmedTrendUp = useHigherTimeframe ? (trendUp and htfTrendUp) : trendUp
confirmedTrendDown = useHigherTimeframe ? (trendDown and htfTrendDown) : trendDown

// ===== 6-STATE REGIME DETECTION =====
string trendState = "No Trend"

if confirmedTrendUp and strongTrend
    trendState := "Strong Trend Long"
else if confirmedTrendUp and weakTrend
    trendState := "Weak Trend Long"
else if confirmedTrendDown and strongTrend
    trendState := "Strong Trend Short"
else if confirmedTrendDown and weakTrend
    trendState := "Weak Trend Short"
else if noTrend
    trendState := "No Trend"
else
    trendState := "Transitioning"

// ===== VISUAL DISPLAY =====
// Each state gets its own plot entry in Style panel for customization
plot(trendState == "Strong Trend Long" ? 1 : na, "Strong Trend Long", color=color.new(color.green, 0), style=plot.style_circles, linewidth=4)
plot(trendState == "Weak Trend Long" ? 1 : na, "Weak Trend Long", color=color.new(color.lime, 0), style=plot.style_circles, linewidth=4)
plot(trendState == "No Trend" ? 1 : na, "No Trend", color=color.new(color.gray, 0), style=plot.style_circles, linewidth=4)
plot(trendState == "Weak Trend Short" ? 1 : na, "Weak Trend Short", color=color.new(color.orange, 0), style=plot.style_circles, linewidth=4)
plot(trendState == "Strong Trend Short" ? 1 : na, "Strong Trend Short", color=color.new(color.red, 0), style=plot.style_circles, linewidth=4)
plot(trendState == "Transitioning" ? 1 : na, "Transitioning", color=color.new(color.yellow, 0), style=plot.style_circles, linewidth=4)

// ===== ALERTS =====
alertcondition(trendState == "Strong Trend Long" and trendState[1] != "Strong Trend Long", title="Strong Trend Long", message="Strong uptrend detected")
alertcondition(trendState == "Weak Trend Long" and trendState[1] != "Weak Trend Long", title="Weak Trend Long", message="Weak uptrend detected")
alertcondition(trendState == "No Trend" and trendState[1] != "No Trend", title="No Trend", message="No trend detected")
alertcondition(trendState == "Weak Trend Short" and trendState[1] != "Weak Trend Short", title="Weak Trend Short", message="Weak downtrend detected")
alertcondition(trendState == "Strong Trend Short" and trendState[1] != "Strong Trend Short", title="Strong Trend Short", message="Strong downtrend detected")
alertcondition(trendState == "Transitioning" and trendState[1] != "Transitioning", title="Transitioning", message="Market transitioning between states")
