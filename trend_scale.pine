//@version=6
indicator("Trend Meter 1-9", overlay=false)

// ===== INPUT PARAMETERS =====
// Trend Meter Selections
trendMeter1 = input.string("MACD Crossover - Fast - 8, 21, 5", "Trend Meter 1", options=["MACD Crossover - 12, 26, 9", "MACD Crossover - Fast - 8, 21, 5", "Mom Dad Cross (Top Dog Trading)", "RSI Signal Line Cross - RSI 13, Sig 21", "RSI 13: > or < 50", "RSI 5: > or < 50", "Trend Candles"], group="Trend Meters")

trendMeter2 = input.string("RSI 13: > or < 50", "Trend Meter 2", options=["MACD Crossover - 12, 26, 9", "MACD Crossover - Fast - 8, 21, 5", "Mom Dad Cross (Top Dog Trading)", "RSI Signal Line Cross - RSI 13, Sig 21", "RSI 13: > or < 50", "RSI 5: > or < 50", "Trend Candles"], group="Trend Meters")

trendMeter3 = input.string("RSI 5: > or < 50", "Trend Meter 3", options=["MACD Crossover - 12, 26, 9", "MACD Crossover - Fast - 8, 21, 5", "Mom Dad Cross (Top Dog Trading)", "RSI Signal Line Cross - RSI 13, Sig 21", "RSI 13: > or < 50", "RSI 5: > or < 50", "Trend Candles"], group="Trend Meters")

// ADX for Strength
adxLength = input.int(14, "ADX Length", minval=1, group="Strength Settings")
veryStrongAdx = input.float(40, "Very Strong ADX", minval=1, group="Strength Settings")
strongAdx = input.float(30, "Strong ADX", minval=1, group="Strength Settings")
weakAdx = input.float(20, "Weak ADX", minval=1, group="Strength Settings")

// ===== LIBRARY-READY FUNCTIONS =====

// Standard MACD
calcMacd(fastLen, slowLen, signalLen) =>
    macdLine = ta.ema(close, fastLen) - ta.ema(close, slowLen)
    signalLine = ta.ema(macdLine, signalLen)
    macdLine > signalLine

// Top Dog Trading - Mom Dad
calcMomDad() =>
    topDogMom = ta.ema(close, 5) - ta.ema(close, 20)
    topDogDad = ta.ema(topDogMom, 30)
    topDogMom > topDogDad

// RSI calculations
calcRsi(length) =>
    ta.rsi(close, length) > 50

// RSI Signal Line Cross
calcRsiSigCross() =>
    rsiValue = ta.rsi(close, 13)
    signalLength = 21
    x = bar_index
    y = rsiValue
    x_ = ta.sma(x, signalLength)
    y_ = ta.sma(y, signalLength)
    mx = ta.stdev(x, signalLength)
    my = ta.stdev(y, signalLength)
    c = ta.correlation(x, y, signalLength)
    slope = c * (my / mx)
    inter = y_ - slope * x_
    linReg = x * slope + inter
    rsiValue > linReg

// Trend Candles (Heikin Ashi based)
calcTrendCandles() =>
    haclose = ohlc4
    var float haopen = na
    haopen := na(haopen[1]) ? (open + close) / 2 : (haopen[1] + haclose[1]) / 2
    ccolor = haclose - haopen > 0
    inside6 = haopen <= math.max(haopen[6], haclose[6]) and haopen >= math.min(haopen[6], haclose[6]) and haclose <= math.max(haopen[6], haclose[6]) and haclose >= math.min(haopen[6], haclose[6])
    inside5 = haopen <= math.max(haopen[5], haclose[5]) and haopen >= math.min(haopen[5], haclose[5]) and haclose <= math.max(haopen[5], haclose[5]) and haclose >= math.min(haopen[5], haclose[5])
    inside4 = haopen <= math.max(haopen[4], haclose[4]) and haopen >= math.min(haopen[4], haclose[4]) and haclose <= math.max(haopen[4], haclose[4]) and haclose >= math.min(haopen[4], haclose[4])
    inside3 = haopen <= math.max(haopen[3], haclose[3]) and haopen >= math.min(haopen[3], haclose[3]) and haclose <= math.max(haopen[3], haclose[3]) and haclose >= math.min(haopen[3], haclose[3])
    inside2 = haopen <= math.max(haopen[2], haclose[2]) and haopen >= math.min(haopen[2], haclose[2]) and haclose <= math.max(haopen[2], haclose[2]) and haclose >= math.min(haopen[2], haclose[2])
    inside1 = haopen <= math.max(haopen[1], haclose[1]) and haopen >= math.min(haopen[1], haclose[1]) and haclose <= math.max(haopen[1], haclose[1]) and haclose >= math.min(haopen[1], haclose[1])
    colorvalue = inside6 ? ccolor[6] : inside5 ? ccolor[5] : inside4 ? ccolor[4] : inside3 ? ccolor[3] : inside2 ? ccolor[2] : inside1 ? ccolor[1] : ccolor
    colorvalue

// Get meter result based on selection
getMeterResult(meterChoice) =>
    result = false
    if meterChoice == "MACD Crossover - 12, 26, 9"
        result := calcMacd(12, 26, 9)
    else if meterChoice == "MACD Crossover - Fast - 8, 21, 5"
        result := calcMacd(8, 21, 5)
    else if meterChoice == "Mom Dad Cross (Top Dog Trading)"
        result := calcMomDad()
    else if meterChoice == "RSI Signal Line Cross - RSI 13, Sig 21"
        result := calcRsiSigCross()
    else if meterChoice == "RSI 13: > or < 50"
        result := calcRsi(13)
    else if meterChoice == "RSI 5: > or < 50"
        result := calcRsi(5)
    else if meterChoice == "Trend Candles"
        result := calcTrendCandles()
    result

// Calculate trend scale from meter agreement and ADX strength
calculateTrendScale(meter1Result, meter2Result, meter3Result, adxValue, vsAdx, sAdx, wAdx) =>
    metersPositive = (meter1Result ? 1 : 0) + (meter2Result ? 1 : 0) + (meter3Result ? 1 : 0)
    metersNegative = (not meter1Result ? 1 : 0) + (not meter2Result ? 1 : 0) + (not meter3Result ? 1 : 0)
    all3Positive = metersPositive == 3
    all3Negative = metersNegative == 3
    twoPositive = metersPositive == 2
    twoNegative = metersNegative == 2
    scale = 5
    if all3Positive
        scale := adxValue >= vsAdx ? 9 : adxValue >= sAdx ? 8 : adxValue >= wAdx ? 7 : 6
    else if twoPositive
        scale := 6
    else if all3Negative
        scale := adxValue >= vsAdx ? 1 : adxValue >= sAdx ? 2 : adxValue >= wAdx ? 3 : 4
    else if twoNegative
        scale := 4
    scale

// ===== CALCULATE METER RESULTS =====
meter1Result = getMeterResult(trendMeter1)
meter2Result = getMeterResult(trendMeter2)
meter3Result = getMeterResult(trendMeter3)

// ===== ADX FOR STRENGTH =====
[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)

// ===== CALCULATE TREND SCALE =====
int trendScale = calculateTrendScale(meter1Result, meter2Result, meter3Result, adx, veryStrongAdx, strongAdx, weakAdx)

// ===== VISUAL DISPLAY - MINIMAL DOTS =====
plot(trendScale == 1 ? 1 : na, "Scale 1 - Very Strong Short", color=color.new(color.red, 0), style=plot.style_circles, linewidth=4)
plot(trendScale == 2 ? 1 : na, "Scale 2 - Strong Short", color=color.new(color.red, 30), style=plot.style_circles, linewidth=4)
plot(trendScale == 3 ? 1 : na, "Scale 3 - Weak Short", color=color.new(color.orange, 0), style=plot.style_circles, linewidth=4)
plot(trendScale == 4 ? 1 : na, "Scale 4 - Very Weak Short", color=color.new(color.orange, 40), style=plot.style_circles, linewidth=4)
plot(trendScale == 5 ? 1 : na, "Scale 5 - No Trend", color=color.new(color.gray, 0), style=plot.style_circles, linewidth=4)
plot(trendScale == 6 ? 1 : na, "Scale 6 - Very Weak Long", color=color.new(color.lime, 40), style=plot.style_circles, linewidth=4)
plot(trendScale == 7 ? 1 : na, "Scale 7 - Weak Long", color=color.new(color.lime, 0), style=plot.style_circles, linewidth=4)
plot(trendScale == 8 ? 1 : na, "Scale 8 - Strong Long", color=color.new(color.green, 30), style=plot.style_circles, linewidth=4)
plot(trendScale == 9 ? 1 : na, "Scale 9 - Very Strong Long", color=color.new(color.green, 0), style=plot.style_circles, linewidth=4)

// ===== ALERTS =====
alertcondition(trendScale == 9 and trendScale[1] != 9, title="Scale 9 - Very Strong Long", message="Trend meter reached 9 - Very Strong Long")
alertcondition(trendScale == 8 and trendScale[1] != 8, title="Scale 8 - Strong Long", message="Trend meter reached 8 - Strong Long")
alertcondition(trendScale == 1 and trendScale[1] != 1, title="Scale 1 - Very Strong Short", message="Trend meter reached 1 - Very Strong Short")
alertcondition(trendScale == 2 and trendScale[1] != 2, title="Scale 2 - Strong Short", message="Trend meter reached 2 - Strong Short")
alertcondition(trendScale == 5 and trendScale[1] != 5, title="Scale 5 - No Trend", message="Trend meter reached 5 - No Trend")
alertcondition(trendScale >= 7 and trendScale[1] < 7, title="Bullish Zone Entry", message="Trend meter entered bullish zone")
alertcondition(trendScale <= 3 and trendScale[1] > 3, title="Bearish Zone Entry", message="Trend meter entered bearish zone")
