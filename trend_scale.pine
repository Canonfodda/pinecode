//@version=6
indicator("Trend Meter 1-9", overlay=false)

// ===== INPUT PARAMETERS =====
useAutoCalibration = input.bool(true, "Auto-Calibration Mode", tooltip="Automatically determine optimal settings", group="Mode")
calibrationBars = input.int(500, "Calibration Sample Size", minval=100, maxval=2000, group="Mode")

manualHmaFast = input.int(9, "Fast HMA Length", minval=1, group="Manual Settings")
manualHmaSlow = input.int(21, "Slow HMA Length", minval=1, group="Manual Settings")
manualAdxLength = input.int(14, "ADX Length", minval=1, group="Manual Settings")
manualVeryStrongThreshold = input.float(40, "Very Strong Trend ADX", minval=1, group="Manual Settings")
manualStrongThreshold = input.float(30, "Strong Trend ADX", minval=1, group="Manual Settings")
manualWeakThreshold = input.float(20, "Weak Trend ADX", minval=1, group="Manual Settings")
manualVeryWeakThreshold = input.float(10, "Very Weak Trend ADX", minval=1, group="Manual Settings")

useHigherTimeframe = input.bool(true, "Use Higher Timeframe Confirmation", group="Multi-Timeframe")
htfMultiplier = input.int(3, "Higher Timeframe Multiplier", minval=2, maxval=10, group="Multi-Timeframe")

// ===== LIBRARY-READY FUNCTIONS =====

// Hull Moving Average calculation
calcHma(src, length) =>
    wma1 = ta.wma(src, length / 2)
    wma2 = ta.wma(src, length)
    ta.wma(2 * wma1 - wma2, int(math.sqrt(length)))

// Auto-calibration function - determines optimal parameters
autoCalibrate(lookbackBars) =>
    avgAtr = ta.sma(ta.atr(14), math.min(lookbackBars, 200))
    avgRange = ta.sma(high - low, math.min(lookbackBars, 200))
    volatilityRatio = avgAtr / avgRange

    hmaFast = volatilityRatio > 1.5 ? 12 : volatilityRatio > 1.0 ? 9 : 7
    hmaSlow = volatilityRatio > 1.5 ? 26 : volatilityRatio > 1.0 ? 21 : 16

    [diP, diM, currentAdx] = ta.dmi(14, 14)
    avgAdx = ta.sma(currentAdx, math.min(lookbackBars, 200))

    veryStrongThresh = avgAdx < 20 ? 35 : avgAdx < 30 ? 40 : 45
    strongThresh = avgAdx < 20 ? 25 : avgAdx < 30 ? 30 : 35
    weakThresh = avgAdx < 20 ? 15 : avgAdx < 30 ? 20 : 25
    veryWeakThresh = avgAdx < 20 ? 8 : avgAdx < 30 ? 10 : 12

    [hmaFast, hmaSlow, veryStrongThresh, strongThresh, weakThresh, veryWeakThresh]

// Calculate higher timeframe string
getHtfTimeframe(currentTf, multiplier) =>
    currentTf == "1" ? str.tostring(multiplier) : currentTf == "5" ? str.tostring(5 * multiplier) : currentTf == "15" ? str.tostring(15 * multiplier) : currentTf == "60" ? str.tostring(60 * multiplier) : currentTf == "240" ? str.tostring(240 * multiplier) : currentTf == "D" ? "W" : "M"

// Main trend scale calculation function
calculateTrendScale(regularClose, haClose, hmaFastLen, hmaSlowLen, adxLen, useHtf, htfTf, veryStrongThresh, strongThresh, weakThresh, veryWeakThresh) =>
    regularHmaFast = calcHma(regularClose, hmaFastLen)
    regularHmaSlow = calcHma(regularClose, hmaSlowLen)
    haHmaFast = calcHma(haClose, hmaFastLen)
    haHmaSlow = calcHma(haClose, hmaSlowLen)

    [diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

    regularTrendUp = regularHmaFast > regularHmaSlow
    haTrendUp = haHmaFast > haHmaSlow
    bothAgreeUp = regularTrendUp and haTrendUp

    regularTrendDown = regularHmaFast < regularHmaSlow
    haTrendDown = haHmaFast < haHmaSlow
    bothAgreeDown = regularTrendDown and haTrendDown

    htfHmaFast = useHtf ? request.security(syminfo.tickerid, htfTf, calcHma(close, hmaFastLen)) : regularHmaFast
    htfHmaSlow = useHtf ? request.security(syminfo.tickerid, htfTf, calcHma(close, hmaSlowLen)) : regularHmaSlow
    htfTrendUp = htfHmaFast > htfHmaSlow
    htfTrendDown = htfHmaFast < htfHmaSlow
    htfConfirmsUp = bothAgreeUp and htfTrendUp
    htfConfirmsDown = bothAgreeDown and htfTrendDown

    scale = 5
    if bothAgreeUp
        scale := adx >= veryStrongThresh and htfConfirmsUp ? 9 : adx >= strongThresh and htfConfirmsUp ? 8 : adx >= strongThresh ? 8 : adx >= weakThresh ? 7 : adx >= veryWeakThresh ? 6 : 5
    else if bothAgreeDown
        scale := adx >= veryStrongThresh and htfConfirmsDown ? 1 : adx >= strongThresh and htfConfirmsDown ? 2 : adx >= strongThresh ? 2 : adx >= weakThresh ? 3 : adx >= veryWeakThresh ? 4 : 5

    scale

// ===== AUTO-CALIBRATION STATE =====
var float autoHmaFast = 9.0
var float autoHmaSlow = 21.0
var float autoVeryStrongThreshold = 40.0
var float autoStrongThreshold = 30.0
var float autoWeakThreshold = 20.0
var float autoVeryWeakThreshold = 10.0
var bool calibrationComplete = false

actualCalibrationBars = math.min(calibrationBars, bar_index)

if useAutoCalibration and not calibrationComplete and bar_index >= 100
    [hmaF, hmaS, vsThresh, sThresh, wThresh, vwThresh] = autoCalibrate(actualCalibrationBars)
    autoHmaFast := hmaF
    autoHmaSlow := hmaS
    autoVeryStrongThreshold := vsThresh
    autoStrongThreshold := sThresh
    autoWeakThreshold := wThresh
    autoVeryWeakThreshold := vwThresh
    calibrationComplete := true

// ===== PARAMETER SELECTION =====
hmaFastLength = useAutoCalibration ? int(autoHmaFast) : manualHmaFast
hmaSlowLength = useAutoCalibration ? int(autoHmaSlow) : manualHmaSlow
adxLength = manualAdxLength
veryStrongThreshold = useAutoCalibration ? autoVeryStrongThreshold : manualVeryStrongThreshold
strongThreshold = useAutoCalibration ? autoStrongThreshold : manualStrongThreshold
weakThreshold = useAutoCalibration ? autoWeakThreshold : manualWeakThreshold
veryWeakThreshold = useAutoCalibration ? autoVeryWeakThreshold : manualVeryWeakThreshold

// ===== DATA SOURCES =====
regularClose = close
haClose = request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close)
htfTimeframe = getHtfTimeframe(timeframe.period, htfMultiplier)

// ===== CALCULATE TREND SCALE =====
int trendScale = calculateTrendScale(regularClose, haClose, hmaFastLength, hmaSlowLength, adxLength, useHigherTimeframe, htfTimeframe, veryStrongThreshold, strongThreshold, weakThreshold, veryWeakThreshold)

// ===== VISUAL DISPLAY - MINIMAL DOTS =====
plot(trendScale == 1 ? 1 : na, "Scale 1 - Very Strong Short", color=color.new(color.red, 0), style=plot.style_circles, linewidth=4)
plot(trendScale == 2 ? 1 : na, "Scale 2 - Strong Short", color=color.new(color.red, 30), style=plot.style_circles, linewidth=4)
plot(trendScale == 3 ? 1 : na, "Scale 3 - Weak Short", color=color.new(color.orange, 0), style=plot.style_circles, linewidth=4)
plot(trendScale == 4 ? 1 : na, "Scale 4 - Very Weak Short", color=color.new(color.orange, 40), style=plot.style_circles, linewidth=4)
plot(trendScale == 5 ? 1 : na, "Scale 5 - No Trend", color=color.new(color.gray, 0), style=plot.style_circles, linewidth=4)
plot(trendScale == 6 ? 1 : na, "Scale 6 - Very Weak Long", color=color.new(color.lime, 40), style=plot.style_circles, linewidth=4)
plot(trendScale == 7 ? 1 : na, "Scale 7 - Weak Long", color=color.new(color.lime, 0), style=plot.style_circles, linewidth=4)
plot(trendScale == 8 ? 1 : na, "Scale 8 - Strong Long", color=color.new(color.green, 30), style=plot.style_circles, linewidth=4)
plot(trendScale == 9 ? 1 : na, "Scale 9 - Very Strong Long", color=color.new(color.green, 0), style=plot.style_circles, linewidth=4)

// ===== ALERTS =====
alertcondition(trendScale == 9 and trendScale[1] != 9, title="Scale 9 - Very Strong Long", message="Trend meter reached 9 - Very Strong Long")
alertcondition(trendScale == 8 and trendScale[1] != 8, title="Scale 8 - Strong Long", message="Trend meter reached 8 - Strong Long")
alertcondition(trendScale == 1 and trendScale[1] != 1, title="Scale 1 - Very Strong Short", message="Trend meter reached 1 - Very Strong Short")
alertcondition(trendScale == 2 and trendScale[1] != 2, title="Scale 2 - Strong Short", message="Trend meter reached 2 - Strong Short")
alertcondition(trendScale == 5 and trendScale[1] != 5, title="Scale 5 - No Trend", message="Trend meter reached 5 - No Trend")
alertcondition(trendScale >= 7 and trendScale[1] < 7, title="Bullish Zone Entry", message="Trend meter entered bullish zone")
alertcondition(trendScale <= 3 and trendScale[1] > 3, title="Bearish Zone Entry", message="Trend meter entered bearish zone")
