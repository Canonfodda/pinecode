//@version=6
strategy("RSI-SMA and MACD Cross Strategy",
         overlay=false,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         commission_type=strategy.commission.percent,
         commission_value=0.1)

// ============================================================================
// INPUTS
// ============================================================================

// RSI Settings
rsi_length = input.int(14, "RSI Length", minval=1)
rsi_sma_length = input.int(14, "RSI SMA Length", minval=1)
rsi_lower_zone = input.int(50, "RSI Lower Zone (0 to this)", minval=0, maxval=100)
rsi_upper_zone = input.int(50, "RSI Upper Zone (this to 100)", minval=0, maxval=100)

// MACD Settings
macd_fast = input.int(12, "MACD Fast Length", minval=1)
macd_slow = input.int(26, "MACD Slow Length", minval=1)
macd_signal = input.int(9, "MACD Signal Length", minval=1)

// Exit Settings
enable_rsi_exit = input.bool(true, "Exit on RSI/SMA Crossback", tooltip="When enabled, positions exit when RSI crosses back over its SMA. When disabled, you'll need another exit method.")
enable_smma_exit = input.bool(false, "Exit on SMMA Candle Close", tooltip="LONG exits when 1 candle closes below SMMA. SHORT exits when 1 candle closes above SMMA.")
smma_length = input.int(50, "SMMA Length", minval=1, tooltip="Length for the Smoothed Moving Average exit condition")

// Visual Settings
show_rsi_panel = input.bool(true, "Show RSI Panel")

// ============================================================================
// INDICATOR CALCULATIONS
// ============================================================================

// RSI Calculation
rsi = ta.rsi(close, rsi_length)
rsi_sma = ta.sma(rsi, rsi_sma_length)

// MACD Calculation
[macd_line, signal_line, macd_histogram] = ta.macd(close, macd_fast, macd_slow, macd_signal)

// SMMA Calculation (Smoothed Moving Average - also known as RMA)
smma = ta.rma(close, smma_length)

// ============================================================================
// SIGNAL LOGIC
// ============================================================================

// RSI Crosses
rsi_cross_above_sma = ta.crossover(rsi, rsi_sma)
rsi_cross_below_sma = ta.crossunder(rsi, rsi_sma)
rsi_cross_any = rsi_cross_above_sma or rsi_cross_below_sma

// MACD Crosses
macd_cross_above = ta.crossover(macd_line, signal_line)
macd_cross_below = ta.crossunder(macd_line, signal_line)

// Track potential trade flags
var bool long_flag = false
var bool short_flag = false

// LONG Flag: RSI in lower zone (0-50) AND RSI crosses above SMA
// Only set flag if not currently in a SHORT position
if rsi <= rsi_lower_zone and rsi_cross_above_sma and strategy.position_size >= 0
    long_flag := true
    short_flag := false

// SHORT Flag: RSI in upper zone (50-100) AND RSI crosses below SMA
// Only set flag if not currently in a LONG position
if rsi >= rsi_upper_zone and rsi_cross_below_sma and strategy.position_size <= 0
    short_flag := true
    long_flag := false

// Clear flags on any RSI/SMA cross (for exit logic with RSI exit enabled)
if enable_rsi_exit and rsi_cross_any and strategy.position_size != 0
    long_flag := false
    short_flag := false

// Entry Conditions
// Additional safety: ensure not in opposite position
long_entry = long_flag and macd_cross_above and strategy.position_size >= 0
short_entry = short_flag and macd_cross_below and strategy.position_size <= 0

// SMMA Exit Conditions
// LONG: Exit when candle open AND close are both below SMMA
smma_exit_long = enable_smma_exit and strategy.position_size > 0 and open < smma and close < smma

// SHORT: Exit when candle open AND close are both above SMMA
smma_exit_short = enable_smma_exit and strategy.position_size < 0 and open > smma and close > smma

// Combined Exit Conditions
exit_long = (enable_rsi_exit and strategy.position_size > 0 and rsi_cross_any) or smma_exit_long
exit_short = (enable_rsi_exit and strategy.position_size < 0 and rsi_cross_any) or smma_exit_short

// ============================================================================
// STRATEGY EXECUTION
// ============================================================================

// Long Entry
if long_entry
    strategy.entry("Long", strategy.long)
    long_flag := false  // Clear flag after entry

// Short Entry
if short_entry
    strategy.entry("Short", strategy.short)
    short_flag := false  // Clear flag after entry

// Exits
if exit_long
    exit_reason = smma_exit_long ? "SMMA Exit" : "RSI/SMA Exit"
    strategy.close("Long", comment=exit_reason)

if exit_short
    exit_reason = smma_exit_short ? "SMMA Exit" : "RSI/SMA Exit"
    strategy.close("Short", comment=exit_reason)

// ============================================================================
// VISUALIZATIONS
// ============================================================================

// Plot RSI and its SMA (conditionally visible)
plot(show_rsi_panel ? rsi : na, "RSI", color=color.new(color.blue, 0), linewidth=2)
plot(show_rsi_panel ? rsi_sma : na, "RSI SMA", color=color.new(color.orange, 0), linewidth=2)

// Plot zones (always drawn but can be toggled off with show_rsi_panel)
hline(rsi_lower_zone, "Lower Zone", color=color.new(color.gray, 50), linestyle=hline.style_dashed)
hline(rsi_upper_zone, "Upper Zone", color=color.new(color.gray, 50), linestyle=hline.style_dashed)
hline(50, "Middle", color=color.new(color.gray, 70), linestyle=hline.style_dotted)

// Highlight zones
bgcolor(rsi <= rsi_lower_zone ? color.new(color.green, 95) : na, title="Long Zone")
bgcolor(rsi >= rsi_upper_zone ? color.new(color.red, 95) : na, title="Short Zone")

// Plot entry signals on RSI panel
plotshape(long_flag, "Long Flag", shape.circle, location.bottom, color.new(color.green, 30), size=size.tiny, text="L Flag")
plotshape(short_flag, "Short Flag", shape.circle, location.top, color.new(color.red, 30), size=size.tiny, text="S Flag")
plotshape(long_entry, "Long Entry", shape.triangleup, location.bottom, color.new(color.green, 0), size=size.small, text="LONG")
plotshape(short_entry, "Short Entry", shape.triangledown, location.top, color.new(color.red, 0), size=size.small, text="SHORT")

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(long_flag, "Long Flag", "RSI crossed above SMA in lower zone - watching for MACD confirmation")
alertcondition(short_flag, "Short Flag", "RSI crossed below SMA in upper zone - watching for MACD confirmation")
alertcondition(long_entry, "Long Entry", "LONG ENTRY: MACD confirmed the long setup")
alertcondition(short_entry, "Short Entry", "SHORT ENTRY: MACD confirmed the short setup")
alertcondition(exit_long, "Exit Long", "EXIT LONG: Position closed")
alertcondition(exit_short, "Exit Short", "EXIT SHORT: Position closed")
alertcondition(smma_exit_long, "SMMA Exit Long", "EXIT LONG: Candle closed below SMMA")
alertcondition(smma_exit_short, "SMMA Exit Short", "EXIT SHORT: Candle closed above SMMA")

// ============================================================================
// DASHBOARD (Optional - shows current status)
// ============================================================================

var table dashboard = table.new(position.top_right, 2, 8, border_width=1)

if barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "Indicator", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(dashboard, 1, 0, "Value", bgcolor=color.new(color.gray, 80), text_color=color.white)

    // RSI
    table.cell(dashboard, 0, 1, "RSI", bgcolor=color.new(color.blue, 90))
    table.cell(dashboard, 1, 1, str.tostring(rsi, "#.##"), bgcolor=color.new(color.blue, 90))

    // RSI SMA
    table.cell(dashboard, 0, 2, "RSI SMA", bgcolor=color.new(color.orange, 90))
    table.cell(dashboard, 1, 2, str.tostring(rsi_sma, "#.##"), bgcolor=color.new(color.orange, 90))

    // MACD
    table.cell(dashboard, 0, 3, "MACD", bgcolor=color.new(color.purple, 90))
    table.cell(dashboard, 1, 3, str.tostring(macd_line, "#.####"), bgcolor=color.new(color.purple, 90))

    // Signal
    table.cell(dashboard, 0, 4, "Signal", bgcolor=color.new(color.yellow, 90))
    table.cell(dashboard, 1, 4, str.tostring(signal_line, "#.####"), bgcolor=color.new(color.yellow, 90))

    // SMMA (if enabled)
    if enable_smma_exit
        table.cell(dashboard, 0, 5, "SMMA", bgcolor=color.new(color.purple, 90))
        table.cell(dashboard, 1, 5, str.tostring(smma, "#.##"), bgcolor=color.new(color.purple, 90))
        table.cell(dashboard, 0, 6, "Price vs SMMA", bgcolor=color.new(color.gray, 90))
        smma_relation = close > smma ? "ABOVE" : close < smma ? "BELOW" : "AT"
        table.cell(dashboard, 1, 6, smma_relation, bgcolor=color.new(color.gray, 90))

    // Status
    row_offset = enable_smma_exit ? 7 : 5
    status_text = long_flag ? "LONG FLAG" : short_flag ? "SHORT FLAG" : "NO FLAG"
    status_color = long_flag ? color.green : short_flag ? color.red : color.gray
    table.cell(dashboard, 0, row_offset, "Status", bgcolor=color.new(status_color, 90))
    table.cell(dashboard, 1, row_offset, status_text, bgcolor=color.new(status_color, 90))
