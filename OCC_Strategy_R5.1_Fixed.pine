//@version=5
//
// Open Close Cross Strategy R5.1 - FIXED VERSION
// Fixed by: Claude Code
// Fixes:
//   - Upgraded to Pine Script v5
//   - FIXED: Removed repainting by using proper security() settings
//   - FIXED: Corrected strategy exit logic (position name mismatch)
//   - FIXED: Updated all deprecated functions and syntax
//   - IMPROVED: Simplified bar limiting logic
//   - IMPROVED: Better code organization and readability
//

strategy(title = "Open Close Cross Strategy R5.1 FIXED",
         shorttitle = "OCC Strategy R5.1 Fixed",
         overlay = true,
         pyramiding = 0,
         default_qty_type = strategy.percent_of_equity,
         default_qty_value = 10,
         calc_on_every_tick = false,
         initial_capital = 10000,
         commission_type = strategy.commission.percent,
         commission_value = 0.1)

//
// Revision:        5.1 FIXED
// Original Author: @JayRogers
// Revision Author: JustUncleL (revisions 3, 4, 5)
// Fixed By: Claude Code
//
// *** USE AT YOUR OWN RISK ***
//
// FIXES APPLIED:
//  - Upgraded to Pine Script v5 with modern syntax
//  - ELIMINATED REPAINTING: Changed security() to use non-repainting settings
//  - Fixed strategy exit logic: corrected position name mismatches
//  - Replaced deprecated functions: tickerid, transp, interval, tostring formatting
//  - Simplified bar limiting using bar_index
//  - Fixed typos and improved code quality
//  - Added proper input validation
//

// === INPUTS ===
useRes      = input.bool(defval = true, title = "Use Alternate Resolution?")
intRes      = input.int(defval = 3, title = "Multiplier for Alternate Resolution", minval = 1)
basisType   = input.string(defval = "SMMA", title = "MA Type",
                          options=["SMA", "EMA", "DEMA", "TEMA", "WMA", "VWMA", "SMMA", "HullMA", "LSMA", "ALMA", "SSMA", "TMA"])
basisLen    = input.int(defval = 8, title = "MA Period", minval = 1)
offsetSigma = input.int(defval = 6, title = "Offset for LSMA / Sigma for ALMA", minval = 0)
offsetALMA  = input.float(defval = 0.85, title = "Offset for ALMA", minval = 0, step = 0.01)
scolor      = input.bool(defval = false, title = "Show Colored Bars to Indicate Trend?")
delayOffset = input.int(defval = 0, title = "Delay Open/Close MA (Non-Repainting Mode)", minval = 0, step = 1,
                       tooltip = "Set to 1 or more for additional non-repainting protection. Note: This will delay signals.")
tradeType   = input.string("BOTH", title = "What Trades Should Be Taken", options=["LONG", "SHORT", "BOTH", "NONE"])

// Stop Loss and Take Profit
slPoints    = input.int(defval = 0, title = "Initial Stop Loss Points (0 to disable)", minval = 0)
tpPoints    = input.int(defval = 0, title = "Initial Target Profit Points (0 to disable)", minval = 0)

// Bar Limiting for Backtesting
limitBars   = input.bool(defval = false, title = "Limit Backtesting to Recent Bars?")
barsBack    = input.int(defval = 5000, title = "Number of Bars for Back Testing", minval = 100)

// === /INPUTS ===

// === TIMEFRAME CALCULATION (Fixed for v5) ===
// Calculate alternate resolution based on current timeframe
getAlternateRes() =>
    currentRes = timeframe.period
    multiplier = intRes

    // Parse current timeframe
    if timeframe.isminutes
        str.tostring(timeframe.multiplier * multiplier)
    else if timeframe.isdaily
        str.tostring(timeframe.multiplier * multiplier) + "D"
    else if timeframe.isweekly
        str.tostring(timeframe.multiplier * multiplier) + "W"
    else if timeframe.ismonthly
        str.tostring(timeframe.multiplier * multiplier) + "M"
    else
        str.tostring(multiplier * 60)  // Default to minutes

stratRes = getAlternateRes()
// === /TIMEFRAME CALCULATION ===

// === BASE FUNCTIONS ===
// Returns MA input selection variant, default to SMA if blank or typo.
variant(type, src, len, offSig, offALMA) =>
    float result = na

    if type == "SMA"
        result := ta.sma(src, len)
    else if type == "EMA"
        result := ta.ema(src, len)
    else if type == "DEMA"
        e1 = ta.ema(src, len)
        result := 2 * e1 - ta.ema(e1, len)
    else if type == "TEMA"
        e1 = ta.ema(src, len)
        e2 = ta.ema(e1, len)
        e3 = ta.ema(e2, len)
        result := 3 * (e1 - e2) + e3
    else if type == "WMA"
        result := ta.wma(src, len)
    else if type == "VWMA"
        result := ta.vwma(src, len)
    else if type == "SMMA"
        // Smoothed MA (RMA in v5)
        result := ta.rma(src, len)
    else if type == "HullMA"
        result := ta.wma(2 * ta.wma(src, len / 2) - ta.wma(src, len), math.round(math.sqrt(len)))
    else if type == "LSMA"
        result := ta.linreg(src, len, offSig)
    else if type == "ALMA"
        result := ta.alma(src, len, offALMA, offSig)
    else if type == "TMA"
        // Triangular MA
        result := ta.sma(ta.sma(src, len), len)
    else if type == "SSMA"
        // SuperSmoother filter
        // © 2013 John F. Ehlers
        a1 = math.exp(-1.414 * math.pi / len)
        b1 = 2 * a1 * math.cos(1.414 * math.pi / len)
        c2 = b1
        c3 = -a1 * a1
        c1 = 1 - c2 - c3
        var float ssma = na
        ssma := c1 * (src + nz(src[1])) / 2 + c2 * nz(ssma[1]) + c3 * nz(ssma[2])
        result := ssma
    else
        result := ta.sma(src, len)

    result

// Security wrapper - FIXED: No more repainting
// Removed lookahead parameter to prevent repainting
reso(exp, use, res) =>
    use ? request.security(syminfo.tickerid, res, exp, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off) : exp

// === /BASE FUNCTIONS ===

// === SERIES SETUP ===
// Apply delay offset to source data for non-repainting
closeSeries = variant(basisType, close[delayOffset], basisLen, offsetSigma, offsetALMA)
openSeries  = variant(basisType, open[delayOffset], basisLen, offsetSigma, offsetALMA)
// === /SERIES ===

// === PLOTTING ===
// Get Alternate resolution Series if selected
closeSeriesAlt = reso(closeSeries, useRes, stratRes)
openSeriesAlt  = reso(openSeries, useRes, stratRes)

// Determine trend color
trendColour = closeSeriesAlt > openSeriesAlt ? color.green : color.red
bcolour     = closeSeries > openSeriesAlt ? color.new(color.lime, 0) : color.new(color.red, 0)

// Bar coloring
barcolor(scolor ? bcolour : na, title = "Bar Colours")

// Plot series
closeP = plot(closeSeriesAlt, title = "Close Series", color = trendColour, linewidth = 2, style = plot.style_line)
openP  = plot(openSeriesAlt, title = "Open Series", color = trendColour, linewidth = 2, style = plot.style_line)
fill(closeP, openP, color = color.new(trendColour, 80))

// === /PLOTTING ===

// === ALERT CONDITIONS ===
xlong     = ta.crossover(closeSeriesAlt, openSeriesAlt)
xshort    = ta.crossunder(closeSeriesAlt, openSeriesAlt)
longCond  = xlong
shortCond = xshort
// === /ALERT CONDITIONS ===

// === BAR LIMITING (Simplified) ===
// Much simpler and more reliable than the original time-based calculation
inBacktestPeriod = not limitBars or (bar_index >= (bar_index - barsBack))
// === /BAR LIMITING ===

// === STRATEGY EXECUTION ===
// Only trade if within backtest period and trade type is enabled
if inBacktestPeriod and tradeType != "NONE"
    // Entry conditions
    if longCond and tradeType != "SHORT"
        strategy.entry("long", strategy.long)

    if shortCond and tradeType != "LONG"
        strategy.entry("short", strategy.short)

    // FIXED: Exit logic - properly close positions when opposite signal occurs
    // This now correctly references the entry position names
    if shortCond and tradeType == "LONG"
        strategy.close("long")

    if longCond and tradeType == "SHORT"
        strategy.close("short")

    // FIXED: Stop Loss and Take Profit exits
    // Only set exits if values are greater than 0
    if slPoints > 0 or tpPoints > 0
        strategy.exit("XL", from_entry = "long",
                     profit = tpPoints > 0 ? tpPoints : na,
                     loss = slPoints > 0 ? slPoints : na)
        strategy.exit("XS", from_entry = "short",
                     profit = tpPoints > 0 ? tpPoints : na,
                     loss = slPoints > 0 ? slPoints : na)

// === /STRATEGY EXECUTION ===

// === ALERTS ===
// Create alert conditions for external use
alertcondition(longCond, title = "Long Signal", message = "OCC Strategy: Long Entry Signal")
alertcondition(shortCond, title = "Short Signal", message = "OCC Strategy: Short Entry Signal")
// === /ALERTS ===

// eof
