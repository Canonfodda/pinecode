//@version=6
indicator("Adaptive Fib Pullback Monitor", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================
lookbackPeriod = input.int(20, "Swing Low Lookback", minval=5, maxval=200)
useATRAdaptive = input.bool(false, "Use ATR Adaptive Lookback")
atrPeriod = input.int(14, "ATR Period", minval=1)
atrMultiplier = input.float(0.5, "ATR Lookback Multiplier", minval=0.1, maxval=5.0)

level1 = input.float(25.0, "Level 1 Retracement (%)", minval=0, maxval=100)
level2 = input.float(33.0, "Level 2 Retracement (%)", minval=0, maxval=100)
level3 = input.float(50.0, "Level 3 Retracement (%)", minval=0, maxval=100)
level4 = input.float(61.8, "Level 4 Retracement (%)", minval=0, maxval=100)

trendDetectionPeriod = input.int(50, "Trend Detection Period", minval=10, maxval=200)
showSwingPoints = input.bool(true, "Show Swing Low/High")
showLevels = input.bool(true, "Show Retracement Levels")
showTable = input.bool(true, "Show Info Table")

// ============================================================================
// ADAPTIVE LOOKBACK
// ============================================================================
atrValue = ta.atr(atrPeriod)
avgATR = ta.sma(atrValue, 20)
atrRatio = avgATR > 0 ? atrValue / avgATR : 1.0
adaptiveLookback = useATRAdaptive ? int(lookbackPeriod * (1 + atrMultiplier * (atrRatio - 1))) : lookbackPeriod
finalLookback = math.max(5, math.min(nz(adaptiveLookback, lookbackPeriod), 200))

// ============================================================================
// SWING LOW AND HIGH DETECTION
// ============================================================================
swingLow = ta.lowest(low, finalLookback)
swingHigh = ta.highest(high, finalLookback)

moveRange = swingHigh - swingLow
validMove = moveRange > 0

// ============================================================================
// TREND DETECTION
// ============================================================================
// Determine trend based on price position relative to swing points
trendSMA = ta.sma(close, trendDetectionPeriod)
isUptrend = close > trendSMA and low > swingLow
isDowntrend = close < trendSMA and high < swingHigh

// ============================================================================
// FIBONACCI RETRACEMENT LEVELS
// ============================================================================
// For downtrend: retracements from swing high (price pulling back up)
// For uptrend: retracements from swing low (price pulling back down)
level1Price = float(na)
level2Price = float(na)
level3Price = float(na)
level4Price = float(na)

if validMove and isDowntrend
    // Downtrend: calculate retracements from swing high
    level1Price := swingHigh - (moveRange * level1 / 100)
    level2Price := swingHigh - (moveRange * level2 / 100)
    level3Price := swingHigh - (moveRange * level3 / 100)
    level4Price := swingHigh - (moveRange * level4 / 100)
else if validMove and isUptrend
    // Uptrend: calculate retracements from swing low
    level1Price := swingLow + (moveRange * level1 / 100)
    level2Price := swingLow + (moveRange * level2 / 100)
    level3Price := swingLow + (moveRange * level3 / 100)
    level4Price := swingLow + (moveRange * level4 / 100)

// ============================================================================
// CURRENT POSITION ANALYSIS
// ============================================================================
currentPrice = close
priceInRange = validMove and currentPrice <= swingHigh and currentPrice >= swingLow

// Calculate pullback percentage based on trend direction
currentPullbackPercent = 0.0
level1Hit = false
level2Hit = false
level3Hit = false
level4Hit = false

if validMove and isDowntrend
    // Downtrend: measure pullback from swing low upward
    currentPullbackPercent := ((currentPrice - swingLow) / moveRange) * 100
    level1Hit := priceInRange and currentPrice >= level1Price and currentPrice < level2Price
    level2Hit := priceInRange and currentPrice >= level2Price and currentPrice < level3Price
    level3Hit := priceInRange and currentPrice >= level3Price and currentPrice < level4Price
    level4Hit := priceInRange and currentPrice >= level4Price
else if validMove and isUptrend
    // Uptrend: measure pullback from swing high downward
    currentPullbackPercent := ((swingHigh - currentPrice) / moveRange) * 100
    level1Hit := priceInRange and currentPrice <= level1Price and currentPrice > level2Price
    level2Hit := priceInRange and currentPrice <= level2Price and currentPrice > level3Price
    level3Hit := priceInRange and currentPrice <= level3Price and currentPrice > level4Price
    level4Hit := priceInRange and currentPrice <= level4Price

// ============================================================================
// VISUAL OUTPUTS - SWING POINTS
// ============================================================================
// Show swing high only in downtrend, swing low only in uptrend
plot(showSwingPoints and isDowntrend ? swingHigh : na, "Swing High", color=color.new(color.red, 40), linewidth=2, style=plot.style_line)
plot(showSwingPoints and isUptrend ? swingLow : na, "Swing Low", color=color.new(color.green, 40), linewidth=2, style=plot.style_line)

// ============================================================================
// VISUAL OUTPUTS - FIB LEVELS
// ============================================================================
plot(showLevels ? level1Price : na, "Fib Level 1", color=color.new(color.green, 30), linewidth=2, style=plot.style_line)
plot(showLevels ? level2Price : na, "Fib Level 2", color=color.new(color.yellow, 30), linewidth=2, style=plot.style_line)
plot(showLevels ? level3Price : na, "Fib Level 3", color=color.new(color.orange, 30), linewidth=2, style=plot.style_line)
plot(showLevels ? level4Price : na, "Fib Level 4", color=color.new(color.red, 30), linewidth=2, style=plot.style_line)

// ============================================================================
// BACKGROUND ALERTS
// ============================================================================
bgcolor(level1Hit ? color.new(color.green, 90) : na, title="Level 1 Zone")
bgcolor(level2Hit ? color.new(color.yellow, 90) : na, title="Level 2 Zone")
bgcolor(level3Hit ? color.new(color.orange, 90) : na, title="Level 3 Zone")
bgcolor(level4Hit ? color.new(color.red, 90) : na, title="Level 4 Zone")

// ============================================================================
// INFO TABLE
// ============================================================================
if showTable and barstate.islast
    var table infoTable = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

    table.cell(infoTable, 0, 0, "Metric", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(infoTable, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.gray, 70))

    table.cell(infoTable, 0, 1, "Trend", text_color=color.white)
    trendText = isUptrend ? "Uptrend" : isDowntrend ? "Downtrend" : "Neutral"
    trendColor = isUptrend ? color.green : isDowntrend ? color.red : color.gray
    table.cell(infoTable, 1, 1, trendText, text_color=trendColor)

    table.cell(infoTable, 0, 2, "Swing High", text_color=color.white)
    table.cell(infoTable, 1, 2, str.tostring(swingHigh, format.mintick), text_color=color.blue)

    table.cell(infoTable, 0, 3, "Swing Low", text_color=color.white)
    table.cell(infoTable, 1, 3, str.tostring(swingLow, format.mintick), text_color=color.blue)

    table.cell(infoTable, 0, 4, "Range", text_color=color.white)
    table.cell(infoTable, 1, 4, str.tostring(moveRange, format.mintick), text_color=color.white)

    table.cell(infoTable, 0, 5, "Current Price", text_color=color.white)
    table.cell(infoTable, 1, 5, str.tostring(currentPrice, format.mintick), text_color=color.white)

    table.cell(infoTable, 0, 6, "Pullback %", text_color=color.white)
    pullbackColor = level4Hit ? color.red : level3Hit ? color.orange : level2Hit ? color.yellow : level1Hit ? color.green : color.gray
    table.cell(infoTable, 1, 6, str.tostring(currentPullbackPercent, "#.##") + "%", text_color=pullbackColor)

    table.cell(infoTable, 0, 7, "Status", text_color=color.white)
    statusText = level4Hit ? "L4 (" + str.tostring(level4) + "%)" : level3Hit ? "L3 (" + str.tostring(level3) + "%)" : level2Hit ? "L2 (" + str.tostring(level2) + "%)" : level1Hit ? "L1 (" + str.tostring(level1) + "%)" : "Watching"
    statusColor = level4Hit ? color.red : level3Hit ? color.orange : level2Hit ? color.yellow : level1Hit ? color.green : color.gray
    table.cell(infoTable, 1, 7, statusText, text_color=statusColor)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(ta.cross(currentPrice, level1Price), title="Level 1 Cross")
alertcondition(ta.cross(currentPrice, level2Price), title="Level 2 Cross")
alertcondition(ta.cross(currentPrice, level3Price), title="Level 3 Cross")
alertcondition(ta.cross(currentPrice, level4Price), title="Level 4 Cross")
