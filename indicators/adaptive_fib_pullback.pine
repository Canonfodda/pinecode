//@version=6
indicator("Adaptive Fib Pullback Monitor", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================
swingLength = input.int(21, "Swing Length", minval=1, maxval=50, tooltip="Number of bars on each side to confirm swing high/low")

// ============================================================================
// SWING HIGH/LOW DETECTION USING BUILT-IN FUNCTIONS
// ============================================================================
// Use Pine Script's built-in pivot detection
ph = ta.pivothigh(swingLength, swingLength)
pl = ta.pivotlow(swingLength, swingLength)

// Track BOTH the most recent swing high AND swing low
var float lastSwingHighPrice = na
var int lastSwingHighBar = 0
var line swingHighLine = na

var float lastSwingLowPrice = na
var int lastSwingLowBar = 0
var line swingLowLine = na

if not na(ph)
    lastSwingHighPrice := ph
    lastSwingHighBar := bar_index - swingLength

    // Delete old line and draw new one from swing high
    if not na(swingHighLine)
        line.delete(swingHighLine)
    swingHighLine := line.new(lastSwingHighBar, lastSwingHighPrice, bar_index, lastSwingHighPrice, color=color.red, width=2, extend=extend.right)

if not na(pl)
    lastSwingLowPrice := pl
    lastSwingLowBar := bar_index - swingLength

    // Delete old line and draw new one from swing low
    if not na(swingLowLine)
        line.delete(swingLowLine)
    swingLowLine := line.new(lastSwingLowBar, lastSwingLowPrice, bar_index, lastSwingLowPrice, color=color.green, width=2, extend=extend.right)

// ============================================================================
// VISUAL OUTPUTS
// ============================================================================
// Mark swing points when detected (offset to show at the actual swing bar)
plotshape(not na(ph), style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, offset=-swingLength, title="Swing High")
plotshape(not na(pl), style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, offset=-swingLength, title="Swing Low")
