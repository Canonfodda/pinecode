//@version=6
indicator("Adaptive Fib Pullback Monitor", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================
pivotLookback = input.int(20, "Pivot Lookback Period", minval=5, maxval=200, tooltip="Number of bars to look back for pivot high/low")

// ============================================================================
// PIVOT HIGH/LOW DETECTION
// ============================================================================
// Find the highest high and lowest low over the lookback period
pivotHigh = ta.highest(high, pivotLookback)
pivotLow = ta.lowest(low, pivotLookback)

// Detect when a new pivot is formed (value changed from previous bar)
newPivotHigh = pivotHigh != pivotHigh[1]
newPivotLow = pivotLow != pivotLow[1]

// Track BOTH the most recent pivot high AND pivot low
var float lastPivotHighPrice = na
var int lastPivotHighBar = 0
var line pivotHighLine = na

var float lastPivotLowPrice = na
var int lastPivotLowBar = 0
var line pivotLowLine = na

if newPivotHigh
    lastPivotHighPrice := pivotHigh
    lastPivotHighBar := bar_index

    // Delete old line and draw new one from pivot high
    if not na(pivotHighLine)
        line.delete(pivotHighLine)
    pivotHighLine := line.new(lastPivotHighBar, lastPivotHighPrice, bar_index, lastPivotHighPrice, color=color.red, width=2, extend=extend.right)

if newPivotLow
    lastPivotLowPrice := pivotLow
    lastPivotLowBar := bar_index

    // Delete old line and draw new one from pivot low
    if not na(pivotLowLine)
        line.delete(pivotLowLine)
    pivotLowLine := line.new(lastPivotLowBar, lastPivotLowPrice, bar_index, lastPivotLowPrice, color=color.green, width=2, extend=extend.right)

// ============================================================================
// VISUAL OUTPUTS
// ============================================================================
// Mark pivot points when detected
plotshape(newPivotHigh, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Pivot High")
plotshape(newPivotLow, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Pivot Low")
