//@version=6
indicator("Adaptive Fib Pullback Monitor", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================
fractalPeriod = input.int(5, "Fractal Period", minval=2, maxval=50, tooltip="Number of bars before/after for fractal detection")

// ============================================================================
// WILLIAMS FRACTAL DETECTION
// ============================================================================
// Fractal High: high is higher than N bars before AND N bars after
// Fractal Low: low is lower than N bars before AND N bars after

isFractalHigh = true
isFractalLow = true

for i = 1 to fractalPeriod
    if high[fractalPeriod] <= high[fractalPeriod + i] or high[fractalPeriod] <= high[fractalPeriod - i]
        isFractalHigh := false
    if low[fractalPeriod] >= low[fractalPeriod + i] or low[fractalPeriod] >= low[fractalPeriod - i]
        isFractalLow := false

// Track only the MOST RECENT fractal point (either high or low)
var float lastFractalPrice = na
var int lastFractalBar = 0
var bool lastFractalIsHigh = true  // true = high, false = low
var line fractalLine = na

if isFractalHigh
    lastFractalPrice := high[fractalPeriod]
    lastFractalBar := bar_index - fractalPeriod  // The fractal occurred N bars ago
    lastFractalIsHigh := true

    // Delete old line and draw new one from fractal high
    if not na(fractalLine)
        line.delete(fractalLine)
    fractalLine := line.new(lastFractalBar, lastFractalPrice, bar_index, lastFractalPrice, color=color.red, width=2, extend=extend.right)

if isFractalLow
    lastFractalPrice := low[fractalPeriod]
    lastFractalBar := bar_index - fractalPeriod  // The fractal occurred N bars ago
    lastFractalIsHigh := false

    // Delete old line and draw new one from fractal low
    if not na(fractalLine)
        line.delete(fractalLine)
    fractalLine := line.new(lastFractalBar, lastFractalPrice, bar_index, lastFractalPrice, color=color.green, width=2, extend=extend.right)

// ============================================================================
// VISUAL OUTPUTS
// ============================================================================
// Mark fractal points when detected
plotshape(isFractalHigh, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, offset=-fractalPeriod, title="Fractal High")
plotshape(isFractalLow, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, offset=-fractalPeriod, title="Fractal Low")
