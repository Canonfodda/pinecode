//@version=6
indicator("Adaptive Fib Pullback Monitor", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================
lookbackPeriod = input.int(20, "Swing High Lookback", minval=5, maxval=200)
useATRAdaptive = input.bool(false, "Use ATR Adaptive Lookback")
atrPeriod = input.int(14, "ATR Period", minval=1)
atrMultiplier = input.float(0.5, "ATR Lookback Multiplier", minval=0.1, maxval=5.0)

level1 = input.float(25.0, "Level 1 (%)", minval=0, maxval=100)
level2 = input.float(33.0, "Level 2 (%)", minval=0, maxval=100)
level3 = input.float(50.0, "Level 3 (%)", minval=0, maxval=100)
level4 = input.float(61.8, "Level 4 (%)", minval=0, maxval=100)

showSwingHigh = input.bool(true, "Show Swing High Line")
showLevels = input.bool(true, "Show Retracement Levels")
showTable = input.bool(true, "Show Info Table")

// ============================================================================
// CALCULATIONS
// ============================================================================
atrValue = ta.atr(atrPeriod)
avgATR = ta.sma(atrValue, 20)
atrRatio = atrValue / avgATR
adaptiveLookback = useATRAdaptive ? int(lookbackPeriod * (1 + atrMultiplier * (atrRatio - 1))) : lookbackPeriod
finalLookback = math.max(5, math.min(adaptiveLookback, 200))

swingHigh = ta.highest(high, finalLookback)
swingHighPrice = swingHigh

currentPrice = close
pullbackAmount = swingHighPrice - currentPrice
pullbackPercent = (pullbackAmount / swingHighPrice) * 100

inPullback = currentPrice < swingHighPrice

// ============================================================================
// LEVEL CALCULATIONS
// ============================================================================
level1Price = swingHighPrice * (1 - level1 / 100)
level2Price = swingHighPrice * (1 - level2 / 100)
level3Price = swingHighPrice * (1 - level3 / 100)
level4Price = swingHighPrice * (1 - level4 / 100)

level1Hit = inPullback and currentPrice <= level1Price
level2Hit = inPullback and currentPrice <= level2Price
level3Hit = inPullback and currentPrice <= level3Price
level4Hit = inPullback and currentPrice <= level4Price

// ============================================================================
// VISUAL OUTPUTS
// ============================================================================
plot(showSwingHigh ? swingHighPrice : na, "Swing High", color=color.new(color.blue, 30), linewidth=2, style=plot.style_line)

plot(showLevels ? level1Price : na, "Level 1", color=color.new(color.green, 60), linewidth=1, style=plot.style_cross)
plot(showLevels ? level2Price : na, "Level 2", color=color.new(color.yellow, 60), linewidth=1, style=plot.style_cross)
plot(showLevels ? level3Price : na, "Level 3", color=color.new(color.orange, 60), linewidth=1, style=plot.style_cross)
plot(showLevels ? level4Price : na, "Level 4", color=color.new(color.red, 60), linewidth=1, style=plot.style_cross)

bgcolor(level1Hit ? color.new(color.green, 90) : na, title="Level 1 Alert")
bgcolor(level2Hit ? color.new(color.yellow, 90) : na, title="Level 2 Alert")
bgcolor(level3Hit ? color.new(color.orange, 90) : na, title="Level 3 Alert")
bgcolor(level4Hit ? color.new(color.red, 90) : na, title="Level 4 Alert")

// ============================================================================
// INFO TABLE
// ============================================================================
if showTable and barstate.islast
    var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

    table.cell(infoTable, 0, 0, "Metric", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(infoTable, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.gray, 70))

    table.cell(infoTable, 0, 1, "Swing High", text_color=color.white)
    table.cell(infoTable, 1, 1, str.tostring(swingHighPrice, format.mintick), text_color=color.blue)

    table.cell(infoTable, 0, 2, "Current Price", text_color=color.white)
    table.cell(infoTable, 1, 2, str.tostring(currentPrice, format.mintick), text_color=color.white)

    table.cell(infoTable, 0, 3, "Pullback %", text_color=color.white)
    pullbackColor = pullbackPercent >= level4 ? color.red : pullbackPercent >= level3 ? color.orange : pullbackPercent >= level2 ? color.yellow : pullbackPercent >= level1 ? color.green : color.gray
    table.cell(infoTable, 1, 3, str.tostring(pullbackPercent, "#.##") + "%", text_color=pullbackColor)

    table.cell(infoTable, 0, 4, "Lookback", text_color=color.white)
    table.cell(infoTable, 1, 4, str.tostring(finalLookback), text_color=color.white)

    table.cell(infoTable, 0, 5, "Status", text_color=color.white)
    statusText = level4Hit ? "L4 HIT" : level3Hit ? "L3 HIT" : level2Hit ? "L2 HIT" : level1Hit ? "L1 HIT" : "Watching"
    statusColor = level4Hit ? color.red : level3Hit ? color.orange : level2Hit ? color.yellow : level1Hit ? color.green : color.gray
    table.cell(infoTable, 1, 5, statusText, text_color=statusColor)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(level1Hit, "Level 1 Hit", "Price pulled back {{level1}}% to {{close}}")
alertcondition(level2Hit, "Level 2 Hit", "Price pulled back {{level2}}% to {{close}}")
alertcondition(level3Hit, "Level 3 Hit", "Price pulled back {{level3}}% to {{close}}")
alertcondition(level4Hit, "Level 4 Hit", "Price pulled back {{level4}}% to {{close}}")
